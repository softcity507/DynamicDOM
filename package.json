{
  "name": "flow-automation",
  "version": "1.0.0",
  "description": "Backend API that drives Google Flow via the DOM (Playwright). Never touches Google's backend API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "login": "tsx src/login.ts",
    "inspect": "tsx src/inspect.ts",
    "detect-drift": "tsx src/detectDrift.ts",
    "capture-dom": "tsx src/captureDom.ts",
    "capture-dom-diff": "tsx src/diffDom.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
