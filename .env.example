# Copy to .env and adjust.

# Port your backend API listens on
PORT=3000

# Simple shared-secret so random callers can't trigger your browser.
# Send it as header:  x-api-key: <this value>


# Where the logged-in Chrome profile is stored (keeps your Google session
# so you only log in once). Anything persistent on disk works.
USER_DATA_DIR=./.chrome-profile

# Show the browser window (true) or run hidden (false).
# Keep true while setting up / logging in. Flip to false for a server.
HEADFUL=true

# The Flow project URL to open. Replace with yours.
FLOW_URL=https://labs.google/fx/tools/flow/project/d2be9d8d-a56c-41a2-9faf-83ce9c8f4720

# Max ms to wait for a single video render before giving up.
RENDER_TIMEOUT_MS=300000

# Optional. Set this to enable AI self-healing: when every static locator in
# flowPage.ts fails (Google changed the DOM), Claude reads the live
# accessibility tree and finds the right element instead of the job just
# failing. Also powers `npm run detect-drift`, which proactively diffs the
# live DOM against a saved baseline and drafts a flowPage.ts fix.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
